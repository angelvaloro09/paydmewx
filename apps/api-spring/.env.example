# Dummy values only. Real ones go in the Render dashboard / your shell, never in git.
# JDBC form of the Neon URL (sslmode=require). Username/password can be inline or separate.
DATABASE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=changeme
PORT=8787
# Same value as the Node API so live sessions survive the cutover. >= 32 chars.
JWT_SECRET=
PEY_BASE_URL=https://api.pey.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_TEST_AMOUNT_OVERRIDE=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Comma-separated explicit allowlist (no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENABLE_DEV_ROUTES=false
