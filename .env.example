# --- pey (https://docs.pey.mx) ---
PEY_BASE_URL=https://api.pey.mx
PEY_API_KEY=
# Webhook secret (whsec_...) shown once in the pey portal
PEY_WEBHOOK_SECRET=
# No sandbox exists: while set, every charge sent to pey uses this amount (MXN).
# Leave empty in real production.
PEY_TEST_AMOUNT_OVERRIDE=0.01

# --- Auth ---
JWT_SECRET=change-me

# --- DB (libsql: local file or Turso) ---
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=

# --- AI (any OpenAI-compatible endpoint; swap to OpenAI later without code changes) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
